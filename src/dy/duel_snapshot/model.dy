import std.typecons

import vibe.data.json


enum DuelType : ubyte
    sail,
    dungeon,
    boss,


struct DuelSnapshot
    string agent
    string host, id
    float  stepDuration = 0
    Nullable!float scale
    int    timezone
    int    step
    Nullable!(int, -1) streamerIndex
    string cargo
    string allies, map, chronicle//HTML.
    string opponent//HTML block for boss opponent panel (v4).
    string[] conditions
    Json   clientData
    DuelType duelType
    string phase//v4: "boss", "dungeon", "sail"
    int    protocolVersion = 3
